{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "trendhaus": {
      "type": "streamable-http",
      "url": "https://mcp.trendhaus.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.trendhaus.ai/oauth/authorize",
            "tokenUrl": "https://mcp.trendhaus.ai/oauth/token",
            "baseScopes": ["trendhaus.read"]
          }
        }
      }
    }
  }
}
